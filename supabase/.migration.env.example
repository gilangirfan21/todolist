# Copy this file to `.migration.env` (already git-ignored) and fill in the real
# connection strings. Get them from each Supabase project's
# Project Settings -> Database -> Connection string -> URI (Session pooler),
# with [YOUR-PASSWORD] replaced by the project's actual database password
# (Project Settings -> Database -> reset password if you don't have it saved).
#
# SOURCE_DB_URL = the "todolist" project (read-only, never written to)
# TARGET_DB_URL = the "superapp" project (schema + data get written here)

SOURCE_DB_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
TARGET_DB_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
